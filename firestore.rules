rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStaff() {
      return currentRole() in ['admin', 'agent'];
    }

    // Listings are public to browse; only admins/agents manage them.
    // The one exception is the view counter, which any visitor increments
    // just by opening a listing (see PropertyService.incrementViews) — so
    // an update that only touches `views` is allowed without staff rights.
    match /properties/{propertyId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    // Users manage their own profile (including savedProperties) but can
    // never grant themselves a staff role. Staff can read any profile to
    // resolve inquiries/listings back to a person.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Anyone (including signed-out visitors) can submit an inquiry —
    // the contact form and property inquiry form both allow userId: null.
    // Only staff can read/triage the resulting leads.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if isStaff();
      allow delete: if false;
    }
  }
}
